<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ichorCNA Summary Report</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px; color: #222; background: #f5f5f5; padding: 24px;
  }
  h1 { font-size: 22px; margin-bottom: 4px; }
  .subtitle { color: #666; margin-bottom: 28px; font-size: 13px; }
  h2 {
    font-size: 16px; margin: 32px 0 12px;
    border-bottom: 2px solid #0066cc; padding-bottom: 4px; color: #0066cc;
  }
  .card {
    background: #fff; border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0,0,0,.12); padding: 16px; margin-bottom: 20px;
    overflow-x: auto;
  }

  /* Summary table */
  table { border-collapse: collapse; width: 100%; }
  thead th {
    background: #0066cc; color: #fff; padding: 8px 10px; text-align: left;
    cursor: pointer; white-space: nowrap; user-select: none;
  }
  thead th:hover { background: #0052a3; }
  thead th::after { content: " ⇅"; font-size: 11px; opacity: .6; }
  tbody tr:nth-child(even) { background: #f0f4ff; }
  tbody tr:hover { background: #ddeeff; }
  td { padding: 7px 10px; border-bottom: 1px solid #e0e0e0; }
  td a { color: #0066cc; text-decoration: none; }
  td a:hover { text-decoration: underline; }

  /* Per-sample blocks */
  .sample-block {
    background: #fff; border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0,0,0,.12); padding: 20px; margin-bottom: 28px;
  }
  .sample-block h3 { font-size: 15px; margin-bottom: 12px; color: #333; }
  .metrics-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .metric-chip {
    background: #eef3ff; border: 1px solid #c0d0f0; border-radius: 20px;
    padding: 4px 12px; font-size: 13px;
  }
  .metric-chip strong { color: #0052a3; }
  /* QC badges */
  .qc-badge {
    display: inline-block; padding: 2px 9px; border-radius: 12px;
    font-size: 11px; font-weight: 700; vertical-align: middle; margin-left: 8px;
  }
  .qc-pass { background: #d4edda; color: #155724; border: 1px solid #b1dfbb; }
  .qc-warn { background: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
  .qc-fail { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
  .qc-na   { background: #e2e3e5; color: #495057; border: 1px solid #ced4da; }

  .figures-toggle { margin-top: 8px; }
  .figures-toggle summary {
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer; font-size: 13px; font-weight: 600;
    color: #0052a3; user-select: none; list-style: none;
    padding: 5px 10px; border-radius: 4px; border: 1px solid #c0d0f0;
    background: #eef3ff;
  }
  .figures-toggle summary::-webkit-details-marker { display: none; }
  .figures-toggle summary::before { content: "▶"; font-size: 10px; transition: transform .15s; }
  .figures-toggle[open] summary::before { transform: rotate(90deg); }
  .figures-toggle summary:hover { background: #dde8ff; }
  .figures { display: flex; flex-direction: column; gap: 14px; margin-top: 12px; }
  .figure-label { font-size: 12px; color: #555; margin-bottom: 4px; }
  embed { border: 1px solid #ddd; border-radius: 4px; display: block; }
</style>
</head>
<body>

<h1>ichorCNA Summary Report</h1>
<p class="subtitle">{{ n_samples }} sample{% if n_samples != 1 %}s{% endif %}</p>

<!-- ======================================================
     Summary table (all samples)
     ====================================================== -->
<h2>Summary Table</h2>
<div class="card">
  <table id="summary-table">
    <thead>
      <tr>
        {% for col in summary_columns %}
        <th>{{ metric_display.get(col, col) }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in summary_rows %}
      <tr>
        {% for col in summary_columns %}
        <td>
          {% if col == "sample" %}
            <a href="#sample-{{ row[col] }}">{{ row[col] }}</a>
          {% elif col == "qc_status" %}
            {% set qc = row[col] if row[col] else 'N/A' %}
            {% if qc == 'PASS' %}{% set qc_cls = 'qc-pass' %}
            {% elif qc == 'WARN' %}{% set qc_cls = 'qc-warn' %}
            {% elif qc == 'FAIL' %}{% set qc_cls = 'qc-fail' %}
            {% else %}{% set qc_cls = 'qc-na' %}{% endif %}
            <span class="qc-badge {{ qc_cls }}">{{ qc }}</span>
          {% elif row[col] is none or row[col] != row[col] %}
            N/A
          {% else %}
            {{ "%.4g" | format(row[col]) if row[col] is number else row[col] }}
          {% endif %}
        </td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<!-- ======================================================
     Per-sample sections
     ====================================================== -->
<h2>Per-Sample Results</h2>

{% for sample in samples %}
<div class="sample-block" id="sample-{{ sample.id }}">
  {% set qc = sample.metrics.get('qc_status', 'N/A') %}
  {% if qc == 'PASS' %}{% set qc_cls = 'qc-pass' %}
  {% elif qc == 'WARN' %}{% set qc_cls = 'qc-warn' %}
  {% elif qc == 'FAIL' %}{% set qc_cls = 'qc-fail' %}
  {% else %}{% set qc_cls = 'qc-na' %}{% endif %}
  <h3>{{ sample.id }}<span class="qc-badge {{ qc_cls }}">{{ qc }}</span></h3>

  <!-- Key metrics as chips -->
  <div class="metrics-grid">
    {% for key, label in metric_display.items() %}
    {% if key != "qc_status" %}
    {% set val = sample.metrics.get(key) %}
    {% if val is not none and val == val %}
    <span class="metric-chip">
      <strong>{{ label }}:</strong>
      {{ "%.4g" | format(val) if val is number else val }}
    </span>
    {% endif %}
    {% endif %}
    {% endfor %}
  </div>

  <!-- Embedded PDF figures -->
  {% if sample.figures %}
  <details class="figures-toggle">
    <summary>Figures ({{ sample.figures | length }})</summary>
    <div class="figures">
      {% for fig in sample.figures %}
      <div>
        <div class="figure-label">{{ fig.label }}</div>
        <embed
          src="data:application/pdf;base64,{{ fig.b64 }}"
          type="application/pdf"
          width="100%"
          height="560px"
        />
      </div>
      {% endfor %}
    </div>
  </details>
  {% endif %}
</div>
{% endfor %}

<!-- ======================================================
     Table sort
     ====================================================== -->
<script>
(function () {
  var table = document.getElementById("summary-table");
  var state = { col: -1, asc: true };

  table.querySelectorAll("thead th").forEach(function (th, idx) {
    th.addEventListener("click", function () {
      var rows = Array.from(table.tBodies[0].rows);
      var asc  = state.col === idx ? !state.asc : true;
      rows.sort(function (a, b) {
        var av = a.cells[idx].textContent.trim();
        var bv = b.cells[idx].textContent.trim();
        var an = parseFloat(av), bn = parseFloat(bv);
        if (!isNaN(an) && !isNaN(bn)) return asc ? an - bn : bn - an;
        return asc ? av.localeCompare(bv) : bv.localeCompare(av);
      });
      rows.forEach(function (r) { table.tBodies[0].appendChild(r); });
      state = { col: idx, asc: asc };
    });
  });
}());
</script>

</body>
</html>